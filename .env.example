# 看山进化 — 环境变量示例
# 复制为 .env 后填写。切勿把真实密钥提交到仓库。

# 知乎开放平台 Access Secret（后端专用，绝不下发前端）
ZHIHU_ACCESS_SECRET=

# 服务端口
PORT=3100

# 运行模式：mock = 全程本地语料，不发起任何外部请求；live = 允许调用知乎开放平台
# 未配置 ZHIHU_ACCESS_SECRET 时，即使设为 live 也会自动降级为 mock
APP_MODE=mock

# 外部请求超时（毫秒）
REQUEST_TIMEOUT_MS=8000

# 缓存有效期（秒）
CACHE_TTL_SEARCH=21600
CACHE_TTL_HOT=1800
CACHE_TTL_REWRITE=86400

# 直答每日调用上限（本地熔断，防止打爆开放平台额度）
DAILY_LIMIT_ANSWER=60
DAILY_LIMIT_SEARCH=8
DAILY_LIMIT_HOT=2
